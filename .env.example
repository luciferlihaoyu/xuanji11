# ============================================================
# 璇玑智脑 - 环境变量配置
#
# Round 3+：数据库已整合为单文件 SQLite + sqlite-vec 向量扩展，
# 部署不再需要独立 MySQL / Zvec 服务。
#
# 必填项：
#   - ADMIN_USERNAME / ADMIN_PASSWORD（管理员登录）
#
# 可选项：
#   - SQLITE_PATH（默认 /data/app/xuanji.db）
#   - Kimi OAuth（留空则禁用，只用本地管理员登录）
#   - TIANGONG_SSO_SECRET（留空则禁用天宫 SSO 联邦登录）
# ============================================================

# ---------- 管理员认证（必填）----------
# 部署后通过此账号密码登录系统
# 示例用户名仅用于本地初始化；生产环境必须修改。
ADMIN_USERNAME=admin
# 生产环境必须设置强密码，不要使用示例值。
ADMIN_PASSWORD=<your-strong-password>

# JWT 密钥（可选，留空则使用随机值；生产环境必须设置 ≥32 字符随机字符串）
JWT_SECRET=<min-32-char-random-string>

# ---------- 数据库（SQLite 单文件）----------
# Zeabur 持久卷挂载点：建议 /data/app
SQLITE_PATH=/data/app/xuanji.db
# 旧 MySQL 兼容：可保留 DATABASE_URL=file:/path/to.db 形式（自动解析为 SQLITE_PATH）
# DATABASE_URL=file:/data/app/xuanji.db

# ---------- Kimi OAuth（可选）----------
# 如需使用 Kimi 账号登录，请配置以下项
APP_ID=
APP_SECRET=
VITE_APP_ID=
VITE_KIMI_AUTH_URL=https://auth.kimi.com
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com
OWNER_UNION_ID=

# ---------- 天宫 SSO 联邦认证（可选）----------
# 配置后开放 GET /sso/launch：天宫签发的一次性 JWT（HS256）换取本地会话。
# 密钥必须与天宫侧 TIANGONG_SSO_SECRET 保持一致（用于验签）。
# 取值等式：天宫配了 TIANGONG_SSO_SECRET 就用同值；天宫未配置（回退 APP_SECRET）时，此处须配天宫的 APP_SECRET 同值。
# TIANGONG_SSO_SECRET=

# ---------- 模型来源（可选）----------
# 天枢 (Tianshu) — New API 兼容的模型聚合网关。
# 配置后自动作为 embedding 与 LLM 关键词抽取的兜底模型来源；
# 显式的 LLM_API_URL / LLM_API_KEY 优先级更高。
TIANSHU_BASE_URL=https://woppis1.zeabur.app
TIANSHU_API_KEY=
#  embedding 模型（需天枢已配置对应渠道）
# TIANSHU_EMBEDDING_MODEL=text-embedding-3-small
# LLM 关键词抽取所用模型
# TIANSHU_CHAT_MODEL=deepseek-v4-flash

# ---------- 直连模型服务（可选，优先级高于天枢）----------
# LLM_API_URL=https://your-llm-endpoint/v1
# LLM_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
