# ============================================================
# 璇玑智脑 - 环境变量配置
#
# 必填项：
#   - DATABASE_URL（数据库连接）
#   - ADMIN_USERNAME / ADMIN_PASSWORD（管理员登录）
#
# 可选项：
#   - Kimi OAuth（留空则禁用，只用本地管理员登录）
#   - BACKUP_ENCRYPTION_KEY（AList 加密备份）
# ============================================================

# ---------- 管理员认证（必填）----------
# 部署后通过此账号密码登录系统
# 示例用户名仅用于本地初始化；生产环境必须修改。
ADMIN_USERNAME=admin
# 生产环境必须设置强密码，不要使用示例值。
ADMIN_PASSWORD=<your-strong-password>

# JWT 密钥（生产环境必填：≥32 字符随机字符串，缺失或过短将拒绝启动；
# 开发环境留空则自动生成随机值，重启后所有会话失效）
JWT_SECRET=<min-32-char-random-string>

# ---------- 数据库（必填）----------
DATABASE_URL=mysql://user:password@host:port/database

# ---------- 备份加密（可选）----------
# 使用 AList 加密备份时必填；任意高强度随机字符串。
# 注意：丢失该密钥将无法恢复已有的加密备份。
BACKUP_ENCRYPTION_KEY=

# ---------- Kimi OAuth（可选）----------
# 如需使用 Kimi 账号登录，请配置以下项
APP_ID=
APP_SECRET=
VITE_APP_ID=
VITE_KIMI_AUTH_URL=https://auth.kimi.com
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com
OWNER_UNION_ID=

# ---------- 模型来源（可选）----------
# 天枢 (Tianshu) — New API 兼容的模型聚合网关。
# 配置后自动作为 embedding 与 LLM 关键词抽取的兜底模型来源；
# 显式的 LLM_API_URL / LLM_API_KEY 优先级更高。
TIANSHU_BASE_URL=https://woppis1.zeabur.app
TIANSHU_API_KEY=
#  embedding 模型（需天枢已配置对应渠道）
# TIANSHU_EMBEDDING_MODEL=text-embedding-3-small
# LLM 关键词抽取所用模型
# TIANSHU_CHAT_MODEL=deepseek-v4-flash

# ---------- 直连模型服务（可选，优先级高于天枢）----------
# LLM_API_URL=https://your-llm-endpoint/v1
# LLM_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
